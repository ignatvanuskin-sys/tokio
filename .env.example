# =============================================================================
# TOKYO auto service — environment
# Copy to `.env` and fill in. NEVER commit the real .env file.
# =============================================================================

# --- Required in production --------------------------------------------------

# PostgreSQL connection string. Without it the site falls back to the DEMO file
# store (and refuses to start in a production build unless ALLOW_DEMO_STORE=1).
# Example (Neon / Supabase / RDS / self-hosted):
DATABASE_URL=postgresql://user:password@host:5432/tokyo?sslmode=require

# Password for /admin. Choose something long; it is the only thing protecting
# your customers' phone numbers.
ADMIN_PASSWORD=

# HMAC key for the admin session cookie. Must be at least 24 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Public origin of the site, no trailing slash.
# Used for canonical URLs, Open Graph, schema.org and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.kz

# --- Venue -------------------------------------------------------------------

# IANA timezone of the workshop. Kokshetau is on Asia/Almaty (UTC+5).
VENUE_TIMEZONE=Asia/Almaty

# --- Owner notifications (Telegram) -----------------------------------------
# Create a bot with @BotFather, add it to a chat/group, then get the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
# If these are empty the site still saves every booking but sends no alert
# (it never pretends to have sent one — see src/lib/notify.ts).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Booking rules (optional; sensible defaults are built in) ----------------
# These are OPERATIONAL choices, not published facts. Confirm with the owner.

# Length of one appointment slot, in minutes. Default 60.
# BOOKING_SLOT_MINUTES=60

# How many cars the workshop accepts per slot. Default 1.
# BOOKING_CAPACITY_PER_SLOT=1

# How soon before a slot online booking closes, in minutes. Default 30.
# BOOKING_MIN_LEAD_MINUTES=30

# How far ahead customers may book, in days. Default 30.
# BOOKING_HORIZON_DAYS=30

# Max Postgres pool connections per instance. Default 10.
# DATABASE_POOL_MAX=10

# --- Safety valve ------------------------------------------------------------
# Set to 1 to allow the demo file store even in a production build.
# Use only for a staging preview — NEVER for the live site.
# ALLOW_DEMO_STORE=1

# --- Cron / housekeeping (optional) -----------------------------------------
# Used if you wire an external scheduler to housekeeping endpoints.
# CRON_SECRET=
