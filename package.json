{
  "name": "tokyo-autoservice",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready website + digital front desk for the TOKYO auto service (Kokshetau, Kazakhstan).",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "images": "node scripts/optimize-images.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "check": "npm run typecheck && npm run test && node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "next": "15.5.26",
    "pg": "8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
