# demo / local storage (contains real customer data at runtime — never commit)
.data/
*.sqlite
*.sqlite3

# Research working files (large and/or re-fetchable).
# The two files below are the ONLY .research artefacts kept in git, because they
# document the provenance of every fact and photo used on the site:
#   .research/results.json         — what was extracted from the 2GIS card
#   .research/photos_manifest.json — source URL + byte size of each of the 17 photos
.research/*
!.research/results.json
!.research/photos_manifest.json
!.research/README.md

# test output
coverage/
.vitest/

