# Normalise line endings so the repo behaves the same on Windows and Linux.
* text=auto eol=lf

# Binary assets — never touched by the text filters.
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# Keep generated SQL and lockfiles exactly as produced.
*.sql       text eol=lf
package-lock.json text eol=lf linguist-generated

# Generated assets: collapsed in diffs and excluded from language stats.
public/photos/**   linguist-generated
public/fonts/**    linguist-generated
public/map.webp    linguist-generated
public/og.jpg      linguist-generated
src/data/*.generated.ts linguist-generated
src/app/fonts.css  linguist-generated
